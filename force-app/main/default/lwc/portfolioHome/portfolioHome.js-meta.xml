<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Pankaj Patil Portfolio</masterLabel>
    <description>Futuristic 3D Sci-Fi Portfolio and Agentforce Command Center for Salesforce Experience Cloud Communities and Portals.</description>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property name="componentHeight" type="String" label="Container Height" default="100vh" description="CSS height for the component (e.g. 100vh, 900px, 100%)." />
            <property name="showTelemetry" type="Boolean" label="Show Telemetry Header" default="true" description="Display the top telemetry HUD with FPS and system ping." />
            <property name="enableAudioByDefault" type="Boolean" label="Enable Audio By Default" default="false" description="Start cosmic synthesizer audio automatically upon user interaction." />
        </targetConfig>
        <targetConfig targets="lightning__AppPage,lightning__HomePage">
            <property name="componentHeight" type="String" label="Container Height" default="850px" description="CSS height for the component (e.g. 850px, 100vh)." />
            <property name="showTelemetry" type="Boolean" label="Show Telemetry Header" default="true" description="Display the top telemetry HUD." />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
